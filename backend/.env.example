# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
ENV=development          # development | production

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-256-bit-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://exchange:password@localhost:5432/exchange?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── HD Wallet Master Seed (BIP39 mnemonic — NEVER commit the real value) ──────
MASTER_SEED_PHRASE=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# ── Key Encryption ─────────────────────────────────────────────────────────────
ENCRYPTION_KEY=replace-with-32-bytes-hex-encoded-key

# ── BSC / EVM ─────────────────────────────────────────────────────────────────
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org/
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_CHAIN_ID=56
BSC_TESTNET_CHAIN_ID=97
USDT_BSC_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# ── TRON ──────────────────────────────────────────────────────────────────────
TRON_GRID_API_KEY=replace-with-your-trongrid-api-key
TRON_GRID_BASE_URL=https://api.trongrid.io
TRON_SHASTA_BASE_URL=https://api.shasta.trongrid.io
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ── Exchange Settings ─────────────────────────────────────────────────────────
EXCHANGE_FEE_RATE=0.001      # 0.1%
REFERRAL_FEE_SHARE=0.30      # 30% of swap fee goes to referrer

# ── External APIs ─────────────────────────────────────────────────────────────
COINGECKO_API_KEY=replace-with-your-coingecko-api-key
