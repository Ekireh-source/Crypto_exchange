# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
ENV=development          # development | production

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=24d3e021e1aa9e54edc0b794520e31da91dab7606fe2aa8efef9ebe7ddf83e38
